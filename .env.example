# Example environment for this repository.
# Copy to .env.local and fill in. NEVER commit a real key — .env.local is
# gitignored and must stay that way.

# ---------------------------------------------------------------------------
# Keybase Answer
# ---------------------------------------------------------------------------

# Master switch. false hides the homepage module and makes /keybase-answer 404.
KEYBASE_ANSWER_ENABLED=true

# Server-side only. Read in lib/keybase-answer/openai-client.ts and nowhere
# else; it is never sent to a browser and never appears in a client bundle.
OPENAI_API_KEY=

# The generation model. Named here and in no other file.
KEYBASE_ANSWER_MODEL=gpt-5.6-terra

# Retrieval embeddings. Changing this re-embeds the corpus on the next index
# run; the retrieval and UI layers are unaffected.
KEYBASE_ANSWER_EMBEDDING_MODEL=text-embedding-3-small

# How many Keybase sources may be sent to the model for one question.
KEYBASE_ANSWER_MAX_SOURCES=6

# Passages per source. With MAX_SOURCES, this is what bounds prompt cost.
KEYBASE_ANSWER_MAX_PASSAGES_PER_SOURCE=3

# Longest question accepted, in characters.
KEYBASE_ANSWER_MAX_QUESTION_LENGTH=600

# Questions per caller per hour.
KEYBASE_ANSWER_HOURLY_LIMIT=8

# Salt for the hashed rate-limit bucket. Any long random string; the raw
# address is never stored.
KEYBASE_ANSWER_RATE_LIMIT_SALT=

# How long a generated answer stays servable, in seconds. Publishing new
# content expires cached answers regardless, by moving the index version.
KEYBASE_ANSWER_CACHE_TTL=604800

# Retrieval thresholds. MIN_RELEVANCE is the floor a source must clear to count
# as evidence at all; STRONG_RELEVANCE is the score at which one source is
# enough on its own.
KEYBASE_ANSWER_MIN_RELEVANCE=0.34
KEYBASE_ANSWER_STRONG_RELEVANCE=0.58
KEYBASE_ANSWER_MIN_RELEVANT_SOURCES=2

# Freshness. WINDOW_DAYS is how recent material must be to answer a question
# asking for the *current* position; HALF_LIFE_DAYS shapes the recency weight
# in ranking.
KEYBASE_ANSWER_FRESHNESS_WINDOW_DAYS=120
KEYBASE_ANSWER_FRESHNESS_HALF_LIFE_DAYS=240

# Origin the indexer reads rendered pages from, so service and company pages
# contribute their full copy rather than only their CMS summary. Can also be
# passed as: npm run keybase-answer:index -- --base-url=...
KEYBASE_ANSWER_INDEX_BASE_URL=http://localhost:3000

# DEVELOPMENT ONLY. Replaces the OpenAI provider with a deterministic local one
# so the feature runs with no key. Ignored whenever NODE_ENV is production: a
# production deployment without a key fails rather than serving invented
# financial answers.
# KEYBASE_ANSWER_USE_MOCK=true

# ---------------------------------------------------------------------------
# Shared infrastructure (already used by the rest of the site)
# ---------------------------------------------------------------------------

# Postgres. The website CMS, the content system, and the Keybase Answer index
# and caches all live here.
DATABASE_URL=

# Public origin. Used for canonical URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://www.keybase.com
# For non-Vercel hosting only: production, staging, or development.
SITE_DEPLOYMENT_ENV=development
# Optional emergency noindex switch; setting true does not override preview safety.
# SEO_INDEXING_ENABLED=false

# ---------------------------------------------------------------------------
# Internal AI  (/internal-ai)
# ---------------------------------------------------------------------------
# The private assistant. It answers from company-controlled infrastructure or
# it does not answer: this feature has no code path to OpenAI, Anthropic,
# Gemini, Azure OpenAI, Bedrock, or any other external inference service, and
# none is to be added. Read only in lib/internal-ai/config.ts; none of these is
# prefixed NEXT_PUBLIC_, so no value here can reach a browser.
#
# Every variable below is OPTIONAL. With all of them unset the feature runs on
# the mock provider, which is the intended Phase 1 state.

# Master switch. false makes /internal-ai and its API 404. Defaults to true.
INTERNAL_AI_ENABLED=

# Origin of the self-hosted inference server — the company GB10 host, once it
# exists (e.g. http://gb10.internal:8000). NO trailing /v1: the client appends
# the path itself. Server-to-server only, on the internal network.
#
# SETTING THIS ENABLES REAL INFERENCE and disables the mock entirely. There is
# no fallback: if the server is then unreachable, users see an error rather
# than placeholder text dressed up as an answer. Leave it empty until the GB10
# is deployed.
LOCAL_LLM_BASE_URL=

# Which model to ask for. Either a registry id from lib/internal-ai/models.ts
# (gpt-oss-120b, qwen3-30b-a3b, gpt-oss-20b) or the provider's own served name
# (e.g. openai/gpt-oss-20b — an open-weights repo id, not an API).
# Required whenever LOCAL_LLM_BASE_URL is set.
LOCAL_LLM_MODEL=

# Whole-request budget in milliseconds. Default 120000.
LOCAL_LLM_TIMEOUT_MS=

# Cap on generated tokens per response. Default 2048.
LOCAL_LLM_MAX_TOKENS=

# Sampling temperature, 0–2. Default 0.2. A literal 0 is honoured.
LOCAL_LLM_TEMPERATURE=

# Reasoning effort for models that expose a thinking channel: low | medium |
# high. Unset leaves it to the server's own default.
LOCAL_LLM_REASONING_EFFORT=

# Longest single message accepted, in characters. Defaults to 4000.
INTERNAL_AI_MAX_MESSAGE_LENGTH=

# Attachment ceilings. The same numbers drive the browser's checks and the
# server's enforcement; the server never trusts the browser's word on a file.
# Defaults: 10 files, 25 MB per file, 50 MB per message.
INTERNAL_AI_MAX_ATTACHMENTS=
INTERNAL_AI_MAX_ATTACHMENT_MB=
INTERNAL_AI_MAX_UPLOAD_MB=
#
# DEPLOYMENT NOTE: a serverless host caps the request body well below these
# defaults — on Vercel it is 4.5 MB for the whole request, and an upload over
# that is rejected by the platform before this code runs. Set the two MB values
# to something under the platform limit for any serverless deployment, or serve
# this route from a host without that cap.

# ---------------------------------------------------------------------------
# Dashboard authentication  (interim — pending company SSO)
# ---------------------------------------------------------------------------
# Server-only. None of these is prefixed NEXT_PUBLIC_, so none can reach a
# browser bundle. Generate all three at once with:  npm run auth:hash
#
# NEVER commit real values. .env.local is gitignored and must stay that way.

# HMAC key that signs dashboard session cookies. Any long random string
# (`openssl rand -base64 32`). REQUIRED IN PRODUCTION: without it the server
# refuses to issue or accept sessions rather than signing with a default key.
# Rotating it signs everyone out immediately — the only revocation a stateless
# session has.
AUTH_SESSION_SECRET=

# The single internal account permitted to sign in to the dashboard.
INTERNAL_ADMIN_EMAIL=

# scrypt hash of that account's password, as printed by `npm run auth:hash`.
# The plaintext password is never stored anywhere. In production, sign-in is
# refused entirely while this is unset.
#
# In development only, leaving this empty falls back to the long-standing local
# password so `npm run dev` still works out of the box.
INTERNAL_ADMIN_PASSWORD_HASH=

# Public launch integrations. Leave unset until real properties are configured.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
CONTACT_INQUIRY_WEBHOOK_URL=
INDEXNOW_KEY=
# GPTBot remains allowed unless explicitly set to block. Search bot policy is separate.
GPTBOT_POLICY=allow

# Website CMS administrator: use npm run auth:hash (interactive) for the scrypt hash.
# Existing CMS sessions are invalidated when these credentials change.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD_HASH=
# Generate a unique random secret with at least 32 characters; never commit it.
ADMIN_SESSION_SECRET=
