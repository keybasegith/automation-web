{
  "name": "keybase-automation-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "cms:migrate": "node --env-file=.env.local scripts/migrate-cms-to-postgres.mjs",
    "cms:clear-newsroom": "node --env-file=.env.local scripts/clear-seeded-newsroom.mjs",
    "copy-pdf-worker": "mkdir -p public/pdfjs && cp node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs public/pdfjs/pdf.worker.min.mjs",
    "postinstall": "npm run copy-pdf-worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@supabase/supabase-js": "^2.105.1",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
